{
  "manifest_version": 3,
  "name": "NotebookLM Naver Report Importer",
  "version": "1.0.0",
  "description": "一鍵建立 NotebookLM 筆記本並匯入 Naver 報告文字分卷。",
  "permissions": ["tabs", "scripting", "storage"],
  "host_permissions": [
    "https://notebooklm.google.com/*",
    "https://raw.githubusercontent.com/*",
    "https://cdn.jsdelivr.net/*"
  ],
  "action": {
    "default_title": "建立 Naver 近10天報告集"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://notebooklm.google.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
